{
  "newLineKind": "auto",
  "typescript": {
    "arrowFunction.useParentheses": "force",
    "exportDeclaration.spaceSurroundingNamedExports": false,
    "importDeclaration.spaceSurroundingNamedImports": false,
    "lineWidth": 120,
    "quoteStyle": "alwaysSingle",
    "spaceAround": false,
    "spaceSurroundingProperties": false,
    "semicolons": "asi",
  },
  "json": {
    "trailingCommas": "jsonc",
    "jsonTrailingCommaFiles": ["dprint.json", "{j,t}sconfig*.json", ".vscode/*.json"],
  },
  "markdown": {},
  "yaml": {},
  "excludes": [
    "**/node_modules",
    "**/*-lock.json",
    "**/*-lock.yaml",
    "!.mcp.json",
  ],
  "plugins": [
    "npm:@dprint/typescript@0.99.2",
    "npm:@dprint/json@0.26.0",
    "npm:@dprint/markdown@0.29.0",
    "npm:dprint-plugin-yaml@0.6.0",
  ],
}
