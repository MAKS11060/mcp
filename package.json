{
  "name": "mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "mcp": "./src/cli.ts"
  },
  "scripts": {
    "dev": "deno run -A --env-file --watch-hmr src/cli.ts",
    "start": "deno run -A --env-file src/cli.ts",
    "tc": "tsc --noEmit",
    "fmt": "dprint fmt",
    "lint": "dprint check",
    "build": "deno compile --node-modules-dir=auto --no-check --allow-all --output dist/mcp src/cli.ts",
    "build:win": "deno compile --node-modules-dir=auto --no-check --allow-all --target x86_64-pc-windows-msvc --output dist/mcp.exe src/cli.ts",
    "build:linux": "deno compile --node-modules-dir=auto --no-check --allow-all --target x86_64-unknown-linux-gnu --output dist/mcp src/cli.ts",
    "build:macos": "deno compile --node-modules-dir=auto --no-check --allow-all --target aarch64-apple-darwin --output dist/mcp src/cli.ts",
    "schema": "deno run --allow-read --allow-write scripts/generate-schema.ts"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.2",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "execa": "^10.0.1",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/deno": "^2.7.0",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.9.1"
}
