{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "server": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "cert": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "log": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "mcp": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "log": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "file"
            }
          ]
        },
        "log_path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "websiteUrl": {
          "type": "string",
          "format": "uri"
        },
        "icons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "src": {
                "type": "string",
                "format": "uri"
              },
              "mimeType": {
                "type": "string"
              },
              "sizes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "theme": {
                "type": "string",
                "enum": [
                  "light",
                  "dark"
                ]
              }
            },
            "required": [
              "src"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mcpServers": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string"
          },
          "auth": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "none"
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "token"
                  },
                  "token": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "type",
                  "token"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "command"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
